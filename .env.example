# Copy to .env and fill in. Every setting also reads from the environment.

PROJECT_NAME=DataForge.Backend
ENVIRONMENT=development          # development | test | production
DEBUG=true                        # must be false in production (also hides /docs)
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL. The login needs CREATEROLE the first time migrations run (they create the sandbox role).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataforge

# Frontend origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Identity. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
# Encrypts MFA secrets and connector credentials. Defaults to a key derived from JWT_SECRET.
# SECRETS_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Email for verification and password resets. Without SMTP_HOST, emails are written to the log (development only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DataForge <no-reply@example.com>
# Where the public contact form's messages go.
# CONTACT_EMAIL=platform-contact@example.com

# Landing zone for uploaded files.
STORAGE_DIR=var/landing
MAX_UPLOAD_MB=250

# Sandbox caps for SQL and analysis.
SANDBOX_STATEMENT_TIMEOUT_MS=15000
SANDBOX_MAX_ROWS=5000

# AI assistant. Without a key, the assistant uses its rule-based planner (still grounded and safe).
# ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5

# Monitors are evaluated every N seconds in-process (0 turns this off; use `dataforge evaluate-monitors` from cron).
MONITOR_INTERVAL_SECONDS=900

# Shared rate limits across API replicas.
# REDIS_URL=redis://localhost:6379/0

# Slack: slash command verification and alert notifications.
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=

# Single sign-on into Superset and Jupyter. Must match integrations/*/.env.
SSO_SHARED_SECRET=replace-with-a-long-random-value

# Apache Superset. Leave SUPERSET_URL empty to turn the integration off.
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USER=dataforge-service
SUPERSET_ADMIN_PASSWORD=replace-with-the-superset-service-password
# The read-only database login Superset uses (created by `dataforge superset-sync`).
BI_DB_PASSWORD=replace-with-a-long-random-value

# JupyterLab. Leave JUPYTER_URL empty to turn the integration off.
JUPYTER_URL=http://localhost:8888/jupyter
JUPYTER_API_TOKEN=replace-with-the-jupyter-service-token

# Prototype conveniences: one-click demo sign-in per role. Never enable in production.
DEMO_MODE=true
DEMO_PASSWORD=DataForge!2026
