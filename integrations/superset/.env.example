# Copy to .env. SSO_SHARED_SECRET and SUPERSET_ADMIN_PASSWORD must match the backend's .env.
SUPERSET_METADATA_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/superset
SUPERSET_SECRET_KEY=replace-with-a-long-random-value
SUPERSET_GUEST_TOKEN_SECRET=replace-with-a-long-random-value
# The service account DataForge's backend uses for Superset's REST API.
SUPERSET_ADMIN_USER=dataforge-service
SUPERSET_ADMIN_PASSWORD=replace-with-a-long-random-value
SSO_SHARED_SECRET=replace-with-the-backend-sso-secret
DATAFORGE_JWT_ISSUER=dataforge
# Origins allowed to embed Superset (the DataForge frontend).
DATAFORGE_FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173
SUPERSET_PORT=8088
# Set to true behind HTTPS (secure cookies, HSTS).
SUPERSET_FORCE_HTTPS=false
