# Copy to .env. SSO_SHARED_SECRET and JUPYTER_API_TOKEN must match the backend's .env.
SSO_SHARED_SECRET=replace-with-the-backend-sso-secret
JUPYTER_API_TOKEN=replace-with-a-long-random-token
# Where kernels reach the DataForge API.
DATAFORGE_API_URL=http://localhost:8000
DATAFORGE_JWT_ISSUER=dataforge
# Origins allowed to frame JupyterLab (the DataForge frontend).
DATAFORGE_FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173
JUPYTER_PORT=8888
# Optional: where notebooks are stored (defaults to ./workspace).
# JUPYTER_WORKSPACE=/srv/dataforge/notebooks
