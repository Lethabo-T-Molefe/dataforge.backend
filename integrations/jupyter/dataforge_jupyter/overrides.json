{
  "@jupyterlab/apputils-extension:themes": {
    "theme": "JupyterLab Light",
    "adaptive-theme": false,
    "theme-scrollbars": true,
    "overrides": {
      "code-font-family": "JetBrains Mono, ui-monospace, monospace",
      "content-font-family": "Instrument Sans, system-ui, sans-serif",
      "ui-font-family": "Instrument Sans, system-ui, sans-serif"
    }
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false",
    "checkForUpdates": false
  },
  "@jupyterlab/notebook-extension:tracker": {
    "codeCellConfig": { "lineNumbers": true, "lineWrap": "off" },
    "markdownCellConfig": { "lineWrap": "on" }
  },
  "@jupyterlab/filebrowser-extension:browser": {
    "showHiddenFiles": false
  },
  "@jupyterlab/extensionmanager-extension:plugin": {
    "enabled": false
  }
}
